<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Pickker</title>
    <link rel="stylesheet" href="Css/login.css">
    <link rel="shortcut icon" href="Imgs/logo.png" type="image/x-icon">
</head>

<body>
    <div class="login-container">
        <div class="login-box">
            <h1>Pickker Login</h1>
            <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
                <p style="color: gray; font-size: small; text-align: center;">Sign in — we’ll create your account if you don’t already have one.</p>
                <a href="/auth/google" class="google-btn"
                    style="display: flex; align-items: center; justify-content: center; gap: 10px;"><img
                        src="Imgs/google.png" alt="" width="20" height="20"> Sign in with Google</a>
                        <a href="/auth/google" class="google-btn"
                    style="display: flex; align-items: center; justify-content: center; gap: 10px;"><img
                    src="Imgs/facebook.png" alt="" width="20" height="20"> Sign in with Facebook</a>
                </form>
                <p style="color: gray; font-size: small; text-align: center;">By Signing in, you agree to our Terms of Service and Privacy Policy.</p>
        </div>
    </div>
</body>

</html>