<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | Pickker.pk</title>
    <link rel="stylesheet" href="/Css/edit-profile.css">
    <link rel="shortcut icon" href="Imgs/logo.png" type="image/x-icon">
</head>

<body>
    <header class="header">
        <div class="logo" style="cursor: pointer;" onclick="window.location.href='/'">Pickker<span>.pk</span></div>
        <nav>
            <a href="/profile">Back to Profile</a>
        </nav>
    </header>

    <main class="form-container">

        <!-- Edit Basic Info Form -->
        <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="edit-form">
            <h2>Edit Profile</h2>

            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" name="name" id="name" value="<%= user.name %>" required>
            </div>

            <div class="form-group">
                <label for="profilePic">Profile Picture</label>
                <input type="file" name="profilePic" id="profilePic" accept="image/*">
            </div>

            <button type="submit" class="save-btn">Save Changes</button>
        </form>

        <!-- CNIC Section -->
        <div class="cnic-section">
            <h2>CNIC Verification</h2>

            <% if (user.cnic && user.cnic.status !=="Not Submitted" ) { %>
                <div class="cnic-status-box">
                    <p><strong>Status:</strong>
                        <% if (user.cnic.status==="Pending" ) { %>
                            <span class="cnic-status pending">Pending</span>
                            <% } else if (user.cnic.status==="approved" ) { %>
                                <span class="verified-badge">✔ Verified</span>
                                <% } else if (user.cnic.status==="Rejected" ) { %>
                                    <span class="cnic-status rejected">Rejected</span>
                                    <% } %>
                    </p>
                </div>
                <% } else { %>
                    <form action="/upload-cnic" method="POST" enctype="multipart/form-data" class="cnic-form">
                        <label for="cnicFront">CNIC Front:</label>
                        <input type="file" name="cnicFront" id="cnicFront" accept="image/*" required>

                        <label for="cnicBack">CNIC Back:</label>
                        <input type="file" name="cnicBack" id="cnicBack" accept="image/*" required>

                        <button type="submit" class="save-btn">Submit for Verification</button>
                    </form>
                    <% } %>
        </div>

        <h2>My Listings</h2>
        <div class="my-listings">
            <% if (userListings.length===0) { %>
                <p>You have no listings.</p>
                <% } else { %>
                    <% userListings.forEach(listing=> { %>
                        <div class="listing-card">
                            <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" class="listing-thumb">
                            <div class="listing-info">
                                <h3>
                                    <%= listing.title %>
                                </h3>
                                <p>PKR <%= listing.price %>
                                </p>
                                <form action="/listing/<%= listing._id %>/delete" method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this listing?');">
                                    <button type="submit" class="delete-btn">Delete</button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
        </div>





    </main>
</body>

</html>