<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pickker.pk - Made in Pakistan Marketplace</title>
    <link rel="stylesheet" href="/Css/index.css">
    <link rel="shortcut icon" href="/Imgs/logo.png" type="image/x-icon">
</head>

<body>
    <!-- Header -->
    <header class="header">
       <div class="logo" onclick="window.location.href='/'" style="cursor: pointer;">Pickker<span>.pk</span></div>
        <form action="/search" method="GET" class="search-bar">
            <input type="text" name="q" placeholder="Search for listings or users..." required>
            <button type="submit">Search</button>
        </form>
        <div class="actions">
            <% if (user) { %>
                <!-- Agar user login hai -->
                <div class="user-info">
                    <div class="profilepic">
                        <img src="<%= user.profilePic %>" alt="profile" class="avatar" width="40" height="40"
                            style="cursor: pointer; border-radius: 50%;" onclick="window.location.href='/profile'">
                        <% if (user.cnic.status==="approved" ) { %>
                            <span class="verified-badge" style="position:relative; right:15px;"><img
                                    src="Imgs/verified-badge.png" alt="" width="10"></span>
                            <% } %>
                    </div>
                    <a href="/chat/inbox" class="cta-btn" style="max-width: 92px;">
                        Inbox
                        <% if(unreadCount>0){ %>
                            <span class="unread-badge"
                                style="position: relative; top: -23px;left: 15px; background: red; color: white;  font-size: 12px; padding: 0px 8px; border-radius: 50%;">
                            </span>
                            <% } %>
                    </a>
                    <button class="post-ad-btn" onclick="window.location.href='/listing/add'">+ Post Ad</button>
                    <a href="/logout" class="logout-btn cta-btn">Logout</a>
                </div>
                <% } else { %>
                    <!-- Agar user login nahi hai -->
                    <button class="login-btn" onclick="window.location.href='/login'">Login</button>
                    <% } %>
        </div>
    </header>

    <!-- Hero Banner -->
    <section class="hero">
        <h1>Welcome to Pickker<span style="color: #ffce00;">.pk</span></h1>
        <p>Pakistan’s Own Marketplace for Physical & Digital Products</p>
        <% if (!user) { %>
            <button class="cta-btn" onclick="window.location.href='/login'">Start Selling</button>
            <% } %>
    </section>

    <!-- Categories -->
    <section class="categories">
        <h2>Browse by Category</h2>
        <div class="category-grid">
            <div class="cat" onclick="window.location.href='/category/mobiles'">Mobiles</div>
            <div class="cat" onclick="window.location.href='/category/cars'">Cars</div>
            <div class="cat" onclick="window.location.href='/category/furniture'">Furniture</div>
            <div class="cat" onclick="window.location.href='/category/real%20estate'">Real Estate</div>
            <div class="cat" onclick="window.location.href='/category/books'">Books</div>
        </div>
    </section>

    <!-- Featured Ads -->
    <section class="featured">
        <h2>Featured Listings</h2>
        <div class="ad-grid" id="adGrid">
            <% if (!listings || listings.length===0) { %>
                <p>No listings available.</p>
                <% } else { %>
                    <% listings.forEach(listing=> { %>
                        <div class="ad-card" onclick="window.location.href='/listing/<%= listing._id %>'"
                            style="cursor: pointer;">
                            <!-- Image Slider -->
                            <div class="image-slider">
                                <% listing.images.forEach(img=> { %>
                                    <img src="<%= img %>" alt="<%= listing.title %>">
                                    <% }) %>
                            </div>

                            <h3>
                                <%= listing.title %>
                            </h3>

                            <p class="price">PKR <%= listing.price %>
                            </p>
                            <span class="category">
                                <%= listing.category %> | <%= listing.condition %>
                            </span>
                            <p class="location">
                                <%= listing.location %>
                            </p>
                            <p class="seller">by <a href="/user/<%= listing.createdBy._id %>">
                                    <%= listing.createdBy.name %>
                                </a></p>
                        </div>
                        <% }) %>
                            <% } %>
        </div>
    </section>





    <!-- Footer -->
    <footer class="footer">
        <p>© 2025 Pickker.pk - Made in Pakistan</p>
        <nav>
            <a href="/terms">Terms & Conditions</a> |
            <a href="/privacy">Privacy Policy</a> |
            <a href="/cnic-policy">CNIC Verification Policy</a>
        </nav>
    </footer>

    <script src="Js/index.js"></script>
</body>

</html>